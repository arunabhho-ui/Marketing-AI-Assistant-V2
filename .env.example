# GroqCloud API keys (separate workloads to reduce per-key request bursts)
GROQ_API_KEY1=
GROQ_API_KEY2=
GROQ_API_KEY3=
# Optional legacy single-key fallback if the split keys are not set
GROQ_API_KEY=
# Optional server-side request budget in estimated tokens per minute (default: 6500)
GROQ_TPM_BUDGET=6500

# Tavily API Key (B2B web search)
TAVILY_API_KEY=

# Geoapify API Key (Places & Address API)
GEOAPIFY_API_KEY=

# Port for backend
PORT=5000
